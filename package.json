{
  "name": "monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "setup": "bash ./scripts/setup.sh",
    "db:reset": "bash ./scripts/setup.sh --reset-db",
    "db:fresh": "pnpm --filter api schema:drop && pnpm --filter api migration:run",
    "storage:clear": "bash ./scripts/clear-storage.sh",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "docker:infra": "docker compose up -d",
    "docker:infra:down": "docker compose down",
    "docker:clean": "docker compose down -v",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@repo/commitlint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.0",
    "@semantic-release/github": "^12.0.9",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "semantic-release": "^25.0.8",
    "turbo": "^2.11.7",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "pnpm": ">=11.0.0"
  }
}
