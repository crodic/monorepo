{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand --forceExit",
    "lint": "eslint .",
    "db:create": "ts-node ./src/database/create-database.ts",
    "seed:run": "ts-node ./src/database/seeds/run-seed.ts",
    "permissions:sync": "ts-node ./src/database/sync-permissions.ts",
    "permissions:clean": "ts-node ./src/database/clean-permissions.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "pnpm typeorm --dataSource=src/database/data-source.ts migration:generate",
    "migration:create": "pnpm typeorm -- migration:create",
    "migration:run": "pnpm typeorm --dataSource=src/database/data-source.ts migration:run",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js -d dist/database/data-source.js migration:run",
    "migration:revert": "pnpm typeorm --dataSource=src/database/data-source.ts migration:revert",
    "migration:revert:prod": "node ./node_modules/typeorm/cli.js -d dist/database/data-source.js migration:revert",
    "seed:run:prod": "node dist/database/seeds/run-seed.js",
    "permissions:sync:prod": "node dist/database/sync-permissions.js",
    "schema:drop": "pnpm typeorm --dataSource=src/database/data-source.ts schema:drop"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/lib-storage": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@bull-board/api": "^6.21.3",
    "@bull-board/express": "^6.21.3",
    "@bull-board/nestjs": "^6.21.3",
    "@casl/ability": "^7.0.1",
    "@keyv/redis": "^6.1.0",
    "@nestjs-modules/mailer": "^3.0.2",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.1",
    "@nestjs/common": "^12.0.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@sentry/nestjs": "^11.7.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.81.5",
    "cache-manager": "^7.2.9",
    "cacheable": "^2.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "express-basic-auth": "^1.2.1",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "keyv": "^6.1.0",
    "mime-types": "^3.0.2",
    "ms": "^2.1.3",
    "multer": "^2.4.0",
    "nestjs-cls": "^7.0.1",
    "nestjs-i18n": "^10.8.5",
    "nestjs-paginate": "^15.0.1",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.1.0",
    "otplib": "^13.5.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "qs": "^6.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.31",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@nestjs/cli": "^12.0.1",
    "@nestjs/schematics": "^12.0.2",
    "@nestjs/testing": "^12.0.2",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "jest": "^30.5.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  }
}
