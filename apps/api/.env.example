# ==============================================================================
# Environment & Application
# ==============================================================================
NODE_ENV=development
TZ=UTC

APP_NAME="NestJS API"
APP_URL=http://localhost:8000
APP_PORT=8000
APP_DEBUG=true
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_LOG_LEVEL=debug
APP_CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ==============================================================================
# Database (PostgreSQL / TypeORM)
# ==============================================================================
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=monorepo
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false

# ==============================================================================
# Redis Cache & Queue
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

# ==============================================================================
# Mailer (Local Mailpit SMTP)
# ==============================================================================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME="No Reply"
MAIL_CLIENT_PORT=8025

# ==============================================================================
# Storage (MinIO / AWS S3)
# ==============================================================================
FILESYSTEM_DISK=public

# Standardized Visibility-to-Disk mapping (matching Laravel):
# Public visibility target disk: 'public' (local disk) or 's3' (S3 bucket with public access / CDN)
STORAGE_PUBLIC_DISK=public
# Private visibility target disk: 'local' (local disk with auth guard) or 's3-private' (private S3 bucket)
STORAGE_PRIVATE_DISK=local

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_BUCKET=public
AWS_PRIVATE_BUCKET=private
AWS_ENDPOINT=http://localhost:9000
AWS_URL=http://localhost:9000/nest-uploads
AWS_USE_PATH_STYLE_ENDPOINT=true

# ==============================================================================
# Authentication & Security
# ==============================================================================
AUTH_JWT_SECRET=988An6Y6G0U5PaceB7PIhssyJ257U1L3vYYPXdHmMvy
AUTH_JWT_TOKEN_EXPIRES_IN=1d
AUTH_REFRESH_SECRET=KZs8bLTjf3QWYGj2bKr2PA4Ejnp9iRZ1rKsQ1iUEhLE
AUTH_REFRESH_TOKEN_EXPIRES_IN=365d
AUTH_FORGOT_SECRET=7AFkUB1ozJ0cs5KN2aLDLd69Ip1E9WyJhjR5z7IcFz4
AUTH_FORGOT_TOKEN_EXPIRES_IN=15m
