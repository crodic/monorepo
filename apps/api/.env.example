# ==============================================================================
# Environment & Application
# ==============================================================================
NODE_ENV=development
TZ=UTC

APP_NAME="NestJS API"
APP_URL=http://localhost:8000
APP_PORT=8000
APP_DEBUG=true
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_LOG_LEVEL=debug
APP_CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ==============================================================================
# Database (PostgreSQL / TypeORM)
# ==============================================================================
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=monorepo
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false

# ==============================================================================
# Redis Cache & Queue
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass
REDIS_TLS_ENABLED=false

# ==============================================================================
# Mailer (Local Mailpit SMTP)
# ==============================================================================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME="No Reply"
MAIL_CLIENT_PORT=8025

# ==============================================================================
# Storage (MinIO / AWS S3)
# ==============================================================================
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_BUCKET=public
AWS_PRIVATE_BUCKET=private
AWS_ENDPOINT=http://localhost:9000
AWS_URL=http://localhost:9000/nest-uploads
AWS_USE_PATH_STYLE_ENDPOINT=true

# ==============================================================================
# Authentication & Security
# ==============================================================================
AUTH_JWT_SECRET=dev-admin-jwt-secret-key-32-chars-minimum
AUTH_JWT_TOKEN_EXPIRES_IN=1d
AUTH_REFRESH_SECRET=dev-admin-refresh-secret-key-32-chars-min
AUTH_REFRESH_TOKEN_EXPIRES_IN=365d
AUTH_FORGOT_SECRET=dev-admin-forgot-secret-key-32-chars-min
AUTH_FORGOT_TOKEN_EXPIRES_IN=15m
AUTH_CONFIRM_EMAIL_SECRET=dev-admin-confirm-email-secret-32
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

USER_AUTH_JWT_SECRET=dev-user-jwt-secret-key-32-chars-minimum
USER_AUTH_JWT_TOKEN_EXPIRES_IN=15m
USER_AUTH_REFRESH_SECRET=dev-user-refresh-secret-key-32-chars-min
USER_AUTH_REFRESH_TOKEN_EXPIRES_IN=365d
USER_AUTH_FORGOT_SECRET=dev-user-forgot-secret-key-32-chars-min
USER_AUTH_FORGOT_TOKEN_EXPIRES_IN=7d
USER_AUTH_CONFIRM_EMAIL_SECRET=dev-user-confirm-email-secret-32
USER_AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

# Client Portal URLs
AUTH_PORTAL_URL=http://localhost:5173
AUTH_PORTAL_RESET_PASSWORD_URL=http://localhost:5173/reset-password
USER_AUTH_CLIENT_URL=http://localhost:3000
USER_AUTH_CLIENT_RESET_PASSWORD_URL=http://localhost:3000/auth/reset-password

# ==============================================================================
# Google OAuth (Optional)
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/user/auth/social/google/callback

# ==============================================================================
# Bull Board & Admin Tools
# ==============================================================================
BULL_BOARD_PATH=/queues
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=adminpassword

# ==============================================================================
# Sentry Error Tracking & Performance Monitoring
# ==============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
