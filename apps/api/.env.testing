# ==============================================================================
# Environment & Application (Testing)
# ==============================================================================
NODE_ENV=test
TZ=UTC

APP_NAME="NestJS API Test"
APP_URL=http://localhost:8001
APP_PORT=8001
APP_DEBUG=false
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_LOG_LEVEL=warn
APP_CORS_ORIGIN=*

# ==============================================================================
# Database (Dedicated Test PostgreSQL)
# ==============================================================================
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=monorepo_test
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false

# ==============================================================================
# Redis Cache & Queue (Test)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

# ==============================================================================
# Mailer (Test)
# ==============================================================================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME="No Reply Test"

# ==============================================================================
# Storage (MinIO / S3 Test)
# ==============================================================================
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_BUCKET=nest-uploads-test
AWS_PRIVATE_BUCKET=nest-uploads-private-test
AWS_ENDPOINT=http://localhost:9000
AWS_URL=http://localhost:9000/nest-uploads-test
AWS_USE_PATH_STYLE_ENDPOINT=true

# ==============================================================================
# Authentication & Security (Test Secrets)
# ==============================================================================
AUTH_JWT_SECRET=test-admin-jwt-secret-key-32-chars-minimum
AUTH_JWT_TOKEN_EXPIRES_IN=1d
AUTH_REFRESH_SECRET=test-admin-refresh-secret-key-32-chars-min
AUTH_REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_FORGOT_SECRET=test-admin-forgot-secret-key-32-chars-min
AUTH_FORGOT_TOKEN_EXPIRES_IN=15m
AUTH_CONFIRM_EMAIL_SECRET=test-admin-confirm-email-secret-32
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

USER_AUTH_JWT_SECRET=test-user-jwt-secret-key-32-chars-minimum
USER_AUTH_JWT_TOKEN_EXPIRES_IN=1d
USER_AUTH_REFRESH_SECRET=test-user-refresh-secret-key-32-chars-min
USER_AUTH_REFRESH_TOKEN_EXPIRES_IN=7d
USER_AUTH_FORGOT_SECRET=test-user-forgot-secret-key-32-chars-min
USER_AUTH_FORGOT_TOKEN_EXPIRES_IN=15m
USER_AUTH_CONFIRM_EMAIL_SECRET=test-user-confirm-email-secret-32
USER_AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

AUTH_PORTAL_URL=http://localhost:5173
AUTH_PORTAL_RESET_PASSWORD_URL=http://localhost:5173/reset-password
USER_AUTH_CLIENT_URL=http://localhost:3000
USER_AUTH_CLIENT_RESET_PASSWORD_URL=http://localhost:3000/auth/reset-password

# ==============================================================================
# Bull Board & Admin Tools (Test)
# ==============================================================================
BULL_BOARD_PATH=/queues
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=adminpassword

# ==============================================================================
# Sentry (Disabled in Testing)
# ==============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=testing
SENTRY_TRACES_SAMPLE_RATE=0
